# Google Gemini (free tier — do not spend money)
GOOGLE_API_KEY=your_google_ai_studio_key

# Model (Flash for free tier)
GEMINI_MODEL=gemini-2.5-flash

# LangSmith observability
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key
LANGCHAIN_PROJECT=trendly-support-agent
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Optional aliases (newer LangSmith SDK names)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=...
# LANGSMITH_PROJECT=trendly-support-agent

# App
REFERENCE_DATE=2026-08-04
HOST=127.0.0.1
PORT=8080
